; Partial Traditional Chinese message overrides for MuMu GPS Controller installer.
; The base English messages are loaded first from Inno Setup's compiler:Default.isl.
; UTF-8 without BOM, as recommended by Inno Setup.
[LangOptions]
LanguageName=繁體中文
LanguageID=$0404
LanguageCodePage=950
DialogFontName=Microsoft JhengHei UI
DialogFontSize=9
WelcomeFontName=Microsoft JhengHei UI
WelcomeFontSize=12

